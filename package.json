{
  "name": "terrarium-tavern",
  "version": "0.3.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE/PROJECT_LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./run-dev.ps1",
    "dev:web": "vite --host 127.0.0.1",
    "build:sdk": "node tools/build-mvu.mjs && esbuild compat/runtime.ts --bundle --format=iife --global-name=TavernRuntime --outfile=src/tavern/static/runtime.js",
    "build": "npm run build:sdk && vue-tsc --noEmit && vite build && node tools/package-web.mjs",
    "test": "vitest run",
    "format": "prettier --write web tests/frontend",
    "format:check": "prettier --check web tests/frontend"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "dompurify": "3.4.15",
    "fast-json-patch": "3.1.1",
    "jquery": "3.7.1",
    "json5": "2.2.3",
    "klona": "2.0.6",
    "lodash": "4.18.1",
    "marked": "16.3.0",
    "mathjs": "15.2.0",
    "vue": "3.5.22",
    "yaml": "2.9.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/jquery": "3.5.32",
    "@types/lodash": "4.17.20",
    "@types/node": "22.18.6",
    "@vitejs/plugin-vue": "5.2.4",
    "esbuild": "0.25.10",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "2.2.12"
  }
}
