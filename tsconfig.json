{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.vue",
    "compat/**/*.ts",
    "vite.config.ts",
    "tests/frontend/**/*.ts"
  ]
}
